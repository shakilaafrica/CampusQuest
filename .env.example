# Copy this file to .env (or .env.local) and fill in your Supabase project's
# API settings (Project Settings -> API in the Supabase dashboard).
#
# NEVER put the "service_role" key here — this file is read by the frontend
# (Vite) and its contents end up in the browser bundle. Only the public
# "anon" key belongs here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
